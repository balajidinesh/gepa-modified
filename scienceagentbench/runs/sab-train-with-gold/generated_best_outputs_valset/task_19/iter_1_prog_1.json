        "generated_code": "import os\nimport pandas as pd\nimport json\nimport numpy as np\nfrom scipy.stats import skew\n\ndef main():\n    # Load data\n    df = pd.read_pickle('/benchmark/datasets/saliva_data/data.pkl')\n\n    # MultiIndex: (condition, subject, sample)\n    # Move the index into columns for easy grouping\n    if not isinstance(df.index, pd.MultiIndex):\n        df = df.set_index(['condition', 'subject', 'sample'])\n    df = df.reset_index()\n    # Group by subject\n    result = {}\n    for (condition, subject), group in df.groupby(['condition', 'subject']):\n        cortisol = group['cortisol'].values\n        samples = group['sample'].values\n        mean_val = float(np.mean(cortisol))\n        skewness = float(skew(cortisol))\n        # Get location (sample) of max and min value\n        max_idx = int(samples[np.argmax(cortisol)])\n        min_idx = int(samples[np.argmin(cortisol)])\n        result[subject] = {\n            'condition': condition,\n            'mean': mean_val,\n            'skewness': skewness,\n            'max_sample': max_idx,\n            'min_sample': min_idx\n        }\n\n    # Write result as json\n    os.makedirs('/pred_results', exist_ok=True)\n    with open('/pred_results/saliva_pred.json', 'w') as f:\n        json.dump(result, f, indent=2)\n\nif __name__ == '__main__':\n    main()\n",
