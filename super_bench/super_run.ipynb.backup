   "metadata": {},
   "outputs": [],
   "source": [
    "def idxmax(lst):\n",
    "    \"\"\"Return the index of the maximum value in a list.\"\"\"\n",
    "    max_val = max(lst)\n",
    "    return lst.index(max_val)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "a76acc34",
   "metadata": {},
   "outputs": [],
   "source": [
    "gepa_state = optimizer.gepa_state\n",
    "best_prog_idx = idxmax(gepa_state.per_program_tracked_scores)\n",
    "best_prog = gepa_state.program_candidates[best_prog_idx]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "6648c85c",
   "metadata": {},
   "outputs": [],
   "source": [
    "optimized_program=best_prog"
   ]
  },
