   "source": [
    "import dspy\n",
    "lm = dspy.LM(\"azure/gpt-4.1\", temperature=1.0, num_retries=30, callbacks=[DelayAndLogCallback()])\n",
    "tlm = dspy.LM(\"azure/gpt-4.1\",temperature=1.0)\n",
    "dspy.configure(lm=lm)"
